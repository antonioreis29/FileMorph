# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
build/
dist/
*.spec
# ...menos as receitas de empacotamento do projeto, que são versionadas de
# propósito: elas são a configuração do instalador, não arquivos gerados.
!FileMorph.spec
!FileMorph-portable.spec

# Ambientes virtuais
.venv/
venv/
env/

# Configurações e logs locais do usuário (gerados em runtime)
*.local.json

# IDEs
.vscode/
.idea/

# PyInstaller
*.manifest

# Sistema
.DS_Store
Thumbs.db

# Arquivos temporários do FileMorph
.filemorph_tmp/
*.filemorph-tmp*

# FFmpeg distribuído junto (ver vendor/ffmpeg/LEIA-ME.md): os executáveis e
# a licença do build escolhido não são versionados, só as instruções.
vendor/ffmpeg/*
!vendor/ffmpeg/LEIA-ME.md
